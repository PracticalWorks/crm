{
  "name": "@practicalworks/crm",
  "version": "0.19.0",
  "description": "A typed client for the Twenty CRM's REST API: companies, people, notes, tasks and opportunities behind one port.",
  "keywords": [
    "twenty",
    "twenty-crm",
    "crm",
    "rest",
    "api-client",
    "typescript",
    "inngest",
    "zod"
  ],
  "homepage": "https://github.com/PracticalWorks/crm/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/PracticalWorks/crm/issues"
  },
  "license": "MIT",
  "author": "Practical Works <hello@practical.works> (https://practical.works)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PracticalWorks/crm.git",
    "directory": "packages/client"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  }
}
